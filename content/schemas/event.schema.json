{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kengranderson.com/schemas/event.schema.json",
  "title": "Event or document record",
  "description": "A dated event, presentation, award, press item, document, or life event. One file per item at content/events/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "title",
    "sources",
    "kind",
    "date"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "description": "One or two plain sentences."
    },
    "body": {
      "type": "string",
      "description": "Longer text. Plain text or simple HTML, as in highlights.json."
    },
    "related": {
      "$ref": "common.schema.json#/$defs/related"
    },
    "media": {
      "$ref": "common.schema.json#/$defs/media"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "approval": {
      "$ref": "common.schema.json#/$defs/approval"
    },
    "editorNotes": {
      "$ref": "common.schema.json#/$defs/editorNotes"
    },
    "kind": {
      "enum": [
        "event",
        "presentation",
        "award",
        "press",
        "document",
        "life-event"
      ]
    },
    "date": {
      "$ref": "common.schema.json#/$defs/partialDate"
    },
    "endDate": {
      "$ref": "common.schema.json#/$defs/partialDate"
    },
    "location": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Ken's role, for example speaker, honoree, author."
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "published"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "approval",
      "summary",
      "sources"
    ],
    "properties": {
      "sources": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
