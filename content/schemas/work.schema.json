{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kengranderson.com/schemas/work.schema.json",
  "title": "Work record",
  "description": "Something Ken developed, delivered, or maintained. One file per project at content/work/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "title",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "description": "One or two plain sentences."
    },
    "body": {
      "type": "string",
      "description": "Longer text. Plain text or simple HTML, as in highlights.json."
    },
    "related": {
      "$ref": "common.schema.json#/$defs/related"
    },
    "media": {
      "$ref": "common.schema.json#/$defs/media"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "approval": {
      "$ref": "common.schema.json#/$defs/approval"
    },
    "editorNotes": {
      "$ref": "common.schema.json#/$defs/editorNotes"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/partialDate"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/partialDate"
        },
        "ongoing": {
          "type": "boolean"
        }
      }
    },
    "role": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "label"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "published"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "approval",
      "summary",
      "sources"
    ],
    "properties": {
      "sources": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
